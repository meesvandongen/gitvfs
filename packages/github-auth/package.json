  "keywords": [
    "github",
    "oauth",
    "pkce",
    "github-app",
    "cloudflare-workers",
    "gitvfs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meesvandongen/gitvfs.git",
    "directory": "packages/github-auth"
  },
  "bugs": {
    "url": "https://github.com/meesvandongen/gitvfs/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./server": {
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vp pack",
    "test": "vp test run",
    "test:watch": "vp test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
