{
  "include": ["**/*", "**/.server/**/*", "**/.client/**/*", ".react-router/types/**/*"],
  "exclude": ["build", "node_modules"],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["node", "vite/client"],
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "rootDirs": [".", "./.react-router/types"],
    "paths": {
      "@/*": ["./app/*"],
      "gitvfs": ["../gitvfs/src/index.ts"],
      "gitvfs/providers/github": ["../gitvfs/src/providers/github.ts"],
      "gitvfs-cms": ["../cms/src/index.ts"],
      "gitvfs-cms/react": ["../cms/src/react/index.ts"],
      "gitvfs-github-auth": ["../github-auth/src/index.ts"],
      "gitvfs-github-auth/server": ["../github-auth/src/server.ts"]
    },
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true
  }
}
