{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gitvfs",
  "compatibility_date": "2026-10-22",
  // Token exchange for "Sign in with GitHub" on /admin. Only /api/github/* reaches it.
  "main": "./worker/index.ts",
  // Bundle the workspace source, so the package needs no build first.
  "alias": {
    "gitvfs-github-auth/server": "../github-auth/src/server.ts"
  },
  // Secrets (`wrangler secret put`): GITHUB_CLIENT_SECRET turns sign-in on; the optional
  // GITHUB_SESSION_SECRET (32+ characters) keeps refresh tokens in an encrypted HttpOnly cookie.
  "vars": {
    // A GitHub App; its callback URL is https://docs.gitvfs.mvd.im/admin, with wildcard matching
    // so preview subdomains work too. Its permissions decide what a sign-in may do, so no
    // GITHUB_SCOPE (an OAuth App setting) is needed.
    "GITHUB_CLIENT_ID": "Iv23liL4d3j01dbuzSpS",
    "GITHUB_ALLOWED_ORIGINS": "https://docs.gitvfs.mvd.im"
  },
  // Static output of `pnpm run build`; Workers Builds runs the build, then deploys or previews.
  "assets": {
    "directory": "./build/client",
    // Prerendered pages live at <path>/index.html; serve them without a trailing slash redirect.
    "html_handling": "drop-trailing-slash",
    // scripts/postbuild.mjs copies the SPA fallback to 404.html.
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/github/*"]
  },
  "preview_urls": true,
  // Previews do not inherit production settings. Their URLs are subdomains of the docs domain,
  // which the app's wildcard callback URL accepts. The secret is set separately for previews:
  // `wrangler preview base-config secret put GITHUB_CLIENT_SECRET`; until then they offer token sign-in.
  "previews": {
    "vars": {
      "GITHUB_CLIENT_ID": "Iv23liL4d3j01dbuzSpS",
      "GITHUB_ALLOWED_ORIGINS": "https://*.docs.gitvfs.mvd.im"
    }
  }
}
