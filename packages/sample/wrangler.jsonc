{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gitvfs-demo",
  "compatibility_date": "2026-10-22",
  // Static output of `pnpm run build`; Workers Builds runs the build, then deploys or previews.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "preview_urls": true,
  "previews": {}
}
