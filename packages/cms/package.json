{
  "name": "gitvfs-cms",
  "version": "0.1.0",
  "description": "Git-backed content management for markdown, JSON and YAML content, built on gitvfs and AutoForm",
  "keywords": [
    "cms",
    "git",
    "markdown",
    "frontmatter",
    "github",
    "gitlab",
    "autoform"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meesvandongen/gitvfs.git",
    "directory": "packages/cms"
  },
  "bugs": {
    "url": "https://github.com/meesvandongen/gitvfs/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./react": {
      "import": "./dist/react/index.js"
    },
    "./oidc": {
      "import": "./dist/oidc/index.js"
    },
    "./codemirror": {
      "import": "./dist/codemirror/index.js"
    },
    "./mermaid": {
      "import": "./dist/mermaid/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vp dev",
    "build": "vp pack",
    "test": "vp test run",
    "test:watch": "vp test",
    "typecheck": "tsc --noEmit"
  },
